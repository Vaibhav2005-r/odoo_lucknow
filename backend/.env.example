PORT=5000
DATABASE_URL="postgresql://loopbill:loopbill@localhost:5432/loopbill?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
CLIENT_URL="http://localhost:5173"
APP_TZ="Asia/Kolkata"
COMPANY_NAME="Brightloop Software"
# Local inbox (Mailpit). For real email use smtp.gmail.com, port 465, SMTP_SECURE=true and an app password.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brightloop Billing <billing@brightloop.local>"

# Company details printed on invoices. The first two digits of the GSTIN are our state (09 = Uttar Pradesh):
# customers in the same state pay CGST + SGST, everyone else IGST.
COMPANY_GSTIN="09AABCB1234C1Z7"
COMPANY_ADDRESS="Gomti Nagar, Lucknow, Uttar Pradesh 226010"

# Automatic reminder e-mails
REMINDERS_ENABLED=true
REMINDER_HOUR=9
REMINDER_BATCH_LIMIT=500

# Online payments. Leave the Razorpay values empty to use the built-in test checkout (development only).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# PAYMENT_GATEWAY=mock     # mock (default outside production) or none

# Behind nginx or a load balancer: how many proxies to trust for the client IP
# TRUST_PROXY=1

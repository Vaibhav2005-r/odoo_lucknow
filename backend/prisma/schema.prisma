// Prisma ORM 6.x  —  install with: npm i -D prisma@6 && npm i @prisma/client@6
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
  ADDON
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

// ---------- Identity ----------

model User {
  id           Int                  @id @default(autoincrement())
  name         String
  email        String               @unique // always stored lower-case
  passwordHash String
  role         Role                 @default(CUSTOMER)
  isActive     Boolean              @default(true)
  customer     Customer?
  resetTokens  PasswordResetToken[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the token in the email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String?
  company       String?
  address       String?
  gstin         String?
  userId        Int?           @unique // set when the customer has a portal login
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
}

// ---------- Configuration ----------

model Tax {
  id                Int                @id @default(autoincrement())
  name              String             @unique // "GST 18%"
  rate              Decimal            @db.Decimal(5, 2) // percent
  isActive          Boolean            @default(true)
  products          Product[]
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime           @default(now())
}

model PaymentTerm {
  id            Int                 @id @default(autoincrement())
  name          String              @unique // "Immediate", "15 Days", "30 Days"
  dueDays       Int                 @default(0)
  isActive      Boolean             @default(true)
  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

// ---------- Catalog ----------

model Product {
  id                Int                @id @default(autoincrement())
  name              String
  type              ProductType        @default(SERVICE)
  salesPrice        Decimal            @db.Decimal(12, 2)
  costPrice         Decimal            @default(0) @db.Decimal(12, 2)
  notes             String?
  isActive          Boolean            @default(true)
  taxes             Tax[]
  variants          ProductVariant[]
  plans             Plan[]
  discounts         Discount[]
  subscriptionLines SubscriptionLine[]
  templateLines     TemplateLine[]
  invoiceLines      InvoiceLine[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([name])
}

model ProductVariant {
  id                Int                @id @default(autoincrement())
  productId         Int
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute         String // "Brand"
  value             String // "Odoo"
  extraPrice        Decimal            @default(0) @db.Decimal(12, 2) // +560
  isActive          Boolean            @default(true)
  subscriptionLines SubscriptionLine[]
  templateLines     TemplateLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id            Int                 @id @default(autoincrement())
  name          String              @unique
  productId     Int // the product this plan sells
  product       Product             @relation(fields: [productId], references: [id])
  price         Decimal             @db.Decimal(12, 2) // per unit, per billing period
  billingPeriod BillingPeriod
  minQuantity   Int                 @default(1)
  startDate     DateTime            @db.Date // available from
  endDate       DateTime?           @db.Date // available until (null = open)
  autoClose     Boolean             @default(false) // subscriptions close themselves at expiry
  closable      Boolean             @default(true) // may be closed before expiry
  pausable      Boolean             @default(false)
  renewable     Boolean             @default(true)
  isActive      Boolean             @default(true)
  subscriptions Subscription[]
  templates     QuotationTemplate[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model QuotationTemplate {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  validityDays  Int            @default(30)
  planId        Int
  plan          Plan           @relation(fields: [planId], references: [id])
  paymentTermId Int?
  paymentTerm   PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  notes         String?
  isActive      Boolean        @default(true)
  lines         TemplateLine[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TemplateLine {
  id         Int               @id @default(autoincrement())
  templateId Int
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product           @relation(fields: [productId], references: [id])
  variantId  Int?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  quantity   Int               @default(1)

  @@index([templateId])
}

model Discount {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  type          DiscountType
  value         Decimal        @db.Decimal(12, 2) // rupees for FIXED, percent for PERCENTAGE
  scope         DiscountScope
  minPurchase   Decimal?       @db.Decimal(12, 2)
  minQuantity   Int?
  startDate     DateTime?      @db.Date
  endDate       DateTime?      @db.Date
  usageLimit    Int? // null = unlimited
  usedCount     Int            @default(0)
  isActive      Boolean        @default(true)
  products      Product[] // scope = PRODUCT
  subscriptions Subscription[] // scope = SUBSCRIPTION
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ---------- Sales ----------

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String             @unique // SUB/2026/00001
  customerId      Int
  customer        Customer           @relation(fields: [customerId], references: [id])
  planId          Int
  plan            Plan               @relation(fields: [planId], references: [id])
  templateId      Int?
  template        QuotationTemplate? @relation(fields: [templateId], references: [id])
  paymentTermId   Int
  paymentTerm     PaymentTerm        @relation(fields: [paymentTermId], references: [id])
  discountId      Int?
  discount        Discount?          @relation(fields: [discountId], references: [id])
  status          SubscriptionStatus @default(DRAFT)
  startDate       DateTime           @db.Date
  expiryDate      DateTime           @db.Date // last covered day (inclusive)
  quoteValidUntil DateTime?          @db.Date
  isPaused        Boolean            @default(false)
  pausedAt        DateTime?          @db.Date
  nextPeriodIndex Int                @default(0) // next billing period to invoice (0 = first)
  nextInvoiceDate DateTime?          @db.Date // start of that period (null = nothing left to bill)
  amountSubtotal  Decimal            @default(0) @db.Decimal(12, 2)
  amountDiscount  Decimal            @default(0) @db.Decimal(12, 2)
  amountUntaxed   Decimal            @default(0) @db.Decimal(12, 2)
  amountTax       Decimal            @default(0) @db.Decimal(12, 2)
  amountTotal     Decimal            @default(0) @db.Decimal(12, 2)
  notes           String?
  closedAt        DateTime?
  closeReason     String?
  lines           SubscriptionLine[]
  invoices        Invoice[]
  history         SubscriptionLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([status, nextInvoiceDate])
  @@index([expiryDate])
  @@index([createdAt])
}

model SubscriptionLine {
  id             Int             @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  variantId      Int?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  isActive       Boolean         @default(true) // add-on switched on/off
  taxes          Tax[]
  subtotal       Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @default(0) @db.Decimal(12, 2)

  @@index([subscriptionId])
}

model SubscriptionLog {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  action         String // CREATED, QUOTATION_SENT, CONFIRMED, ACTIVATED, PAUSED, RESUMED, RENEWED, CLOSED, ADDON_ON ...
  note           String?
  userId         Int? // null = system job
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
}

// ---------- Billing ----------

model Invoice {
  id                 Int           @id @default(autoincrement())
  number             String        @unique // INV/2026/00001
  subscriptionId     Int?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  customerId         Int
  customer           Customer      @relation(fields: [customerId], references: [id])
  status             InvoiceStatus @default(DRAFT)
  invoiceDate        DateTime      @db.Date
  dueDate            DateTime      @db.Date
  periodStart        DateTime?     @db.Date
  periodEnd          DateTime?     @db.Date
  amountSubtotal     Decimal       @db.Decimal(12, 2)
  amountDiscount     Decimal       @default(0) @db.Decimal(12, 2)
  amountUntaxed      Decimal       @db.Decimal(12, 2)
  amountTax          Decimal       @db.Decimal(12, 2)
  amountTotal        Decimal       @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(12, 2)
  appliedDiscountIds Int[]         @default([])
  customerSnapshot   Json? // name, email, company, address, gstin at invoice time
  notes              String?
  confirmedAt        DateTime?
  sentAt             DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  lines              InvoiceLine[]
  payments           Payment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([subscriptionId, periodStart]) // ← nothing is billed twice
  @@index([status, dueDate])
  @@index([customerId])
  @@index([invoiceDate])
}

model InvoiceLine {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id])
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2) // snapshot, total % of all taxes on the line
  taxLabel       String? // snapshot, e.g. "GST 18%"
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  customerId   Int
  customer     Customer      @relation(fields: [customerId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime      @db.Date
  note         String?
  recordedById Int?
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([customerId])
}

model Sequence {
  key   String @id // "SUB/2026", "INV/2026"
  value Int    @default(0)
}
